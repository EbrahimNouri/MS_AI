    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def binary_cross_entropy(y, p):\\n\",\n",
    "    \"  epsilon = 1e-12\\n\",\n",
    "    \"  #برای جلوگیری ازlog(0)\\n\",\n",
    "    \"  p = np.clip(p, epsilon, 1 - epsilon)\\n\",\n",
    "    \"  loss = []\\n\",\n",
    "    \"  for i in range(len(y)):\\n\",\n",
    "    \"    loss.append(-(y[i] * np.log([p[i]]) + (1 - y[i]) * np.log(1 - p[i])))\\n\",\n",
    "    \"\\n\",\n",
    "    \"  return pd.DataFrame(loss, columns=[\\\"Loss\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(binary_cross_entropy(y, p))\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_one = [1, 1, 1, 1]\\n\",\n",
    "    \"print(binary_cross_entropy(y_one, p))\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_zero = [0, 0, 0, 0]\\n\",\n",
    "    \"print(binary_cross_entropy(y_zero, p))\\n\"\n",
