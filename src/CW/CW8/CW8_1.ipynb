    "   },\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"\\n\",\n",
    "    \"x = np.array([\\n\",\n",
    "    \"  0.8,  # Study Hours\\n\",\n",
    "    \"  0.9,  # Attendance\\n\",\n",
    "    \"  0.4  # Missed Assignments\\n\",\n",
    "    \"])\\n\",\n",
    "    \"w = np.array([\\n\",\n",
    "    \"  1.2,\\n\",\n",
    "    \"  0.6,\\n\",\n",
    "    \"  -1.5\\n\",\n",
    "    \"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"b = -0.5\\n\",\n",
    "    \"\\n\",\n",
    "    \"z_f = w.T @ x + b\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# print(z_f)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def sigmoid(z):\\n\",\n",
    "    \"  return 1 / (1 + np.exp(-z))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# print(sigmoid(z))\\n\",\n",
    "    \"\\n\",\n",
    "    \"z = [0, 0, 0]\\n\",\n",
    "    \"z[0] = w[0] * x[0]\\n\",\n",
    "    \"z[1] = w[1] * x[1]\\n\",\n",
    "    \"z[2] = w[2] * x[2]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(np.sum(z) + b)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if sigmoid(z_f) >= 0.5:\\n\",\n",
    "    \"  print(f\\\"class 1\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"  print(f\\\"class 0\\\")\"\n",
    "   ],\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"0.3999999999999999\\n\",\n",
    "      \"class 1\\n\"\n",
