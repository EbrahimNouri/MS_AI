    "   \"source\": [\n",
    "    \"y = [1, 1, 0, 0]\\n\",\n",
    "    \"p = [0.95, 0.55, 0.05, 0.9]\\n\",\n",
    "    \"L_A = -(y[0] * np.log([p[0]]) + (1 - y[0]) * np.log(1 - 0.95))\\n\",\n",
