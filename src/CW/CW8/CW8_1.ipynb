    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def neuron_state(x, w, b, threshold=0.5):\\n\",\n",
    "    \"  z = w.T @ x + b\\n\",\n",
    "    \"  if sigmoid(z) >= threshold:\\n\",\n",
    "    \"    predicted_class = \\\"class 1\\\"\\n\",\n",
    "    \"    is_passed = \\\"passed\\\"\\n\",\n",
    "    \"  else:\\n\",\n",
    "    \"    predicted_class = \\\"class 0\\\"\\n\",\n",
    "    \"    is_passed = \\\"Fail\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"  return z, sigmoid(z), threshold, predicted_class, is_passed\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"neuron_state(x, w, b)\\n\",\n",
    "    \"for b in [-1.5, -0.5, 0, 5]:\\n\",\n",
    "    \"  print(f\\\"bias {b}\\\")\\n\",\n",
    "    \"  print(neuron_state(x, w, b))\\n\",\n",
    "    \"  print(\\\"8\\\" * 40)\\n\"\n",
