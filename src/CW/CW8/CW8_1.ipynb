    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def dataset_bce(y_true, y_pred):\\n\",\n",
    "    \"  epsilon = 1e-12\\n\",\n",
    "    \"  #برای جلوگیری ازlog(0)\\n\",\n",
    "    \"  y_pred_1 = np.clip(y_pred, epsilon, 1 - epsilon)\\n\",\n",
    "    \"  loss = []\\n\",\n",
    "    \"  for i in range(len(y_true)):\\n\",\n",
    "    \"    loss.append(-(y_true[i] * np.log([y_pred_1[i]]) + (1 - y_true[i]) * np.log(1 - y_pred_1[i])))\\n\",\n",
    "    \"\\n\",\n",
    "    \"  return np.mean(loss)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"y_true = np.array([1, 1, 0, 0])\\n\",\n",
    "    \"y_pred = np.array([0.95, 0.55, 0.05, 0.90])\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(dataset_bce(y_true, y_pred))\\n\"\n",
